# Byte-compiled / optimized / DLL files
__pycache__/
.ruff_cache/
*.py[cod]
*$py.class

# Virtual environment
.venv
.venv/
.env
env/
venv/

# Build directory
.esphome

# ESPHome drops a starter .gitignore next to any config it generates code for,
# so a compile leaves one behind next to the device configs, in dist/, and next
# to the host test config.
/dist/.gitignore
/devices/*/.gitignore
/tests/host/.gitignore

# Host test run artifacts: the emulated filesystem, the host preferences and the
# captured logs.
/tests/host/.storage/
/tests/host/.prefs/
/tests/host/last-run-*.log

# scripts/qemu.sh writes the emulator wrapper next to the device config.
/devices/*/*.qemu.yaml

# Credentials
secrets.yaml

# vscode
.vscode/*
