{
  "$comment": "Requests to the web_climate_editor API and the answers they get. The format is in doc/TESTING.md.",
  "environment": {
    "max_controllers": 3,
    "climates": [
      "Hall"
    ],
    "sensors": [
      {
        "object_id": "temp_1",
        "name": "Temp 1",
        "unit": "°C"
      },
      {
        "object_id": "temp_2",
        "name": "Temp 2",
        "unit": "°C"
      },
      {
        "object_id": "uptime",
        "name": "Uptime",
        "unit": "s"
      }
    ],
    "switches": [
      {
        "object_id": "relay_1",
        "name": "Relay 1"
      },
      {
        "object_id": "relay_2",
        "name": "Relay 2"
      }
    ],
    "missing": [
      "attic",
      "relay_9"
    ]
  },
  "fixtures": {
    "living-room": {
      "name": "Living Room",
      "kind": "pid",
      "sensor_id": "temp_1",
      "heat": {
        "relay_id": "relay_1"
      },
      "mode": "heat",
      "setpoint": 22
    },
    "floor": {
      "name": "Floor",
      "kind": "bang_bang",
      "sensor_id": "temp_2",
      "heat": {
        "relay_id": "relay_2"
      },
      "mode": "heat",
      "setpoint": 24
    },
    "guest-room": {
      "name": "Guest Room",
      "enabled": false,
      "kind": "bang_bang",
      "sensor_id": "temp_1",
      "heat": {
        "relay_id": "relay_1"
      },
      "mode": "heat",
      "setpoint": 19
    },
    "studio": {
      "name": "Studio",
      "enabled": false,
      "kind": "pid",
      "sensor_id": "temp_1",
      "heat": {
        "relay_id": "relay_1"
      },
      "cool": {
        "relay_id": "relay_2"
      },
      "mode": "heat_cool",
      "setpoint": 22
    },
    "attic": {
      "name": "Attic",
      "enabled": false,
      "kind": "pid",
      "sensor_id": "attic",
      "heat": {
        "relay_id": "relay_1"
      },
      "mode": "heat",
      "setpoint": 20
    },
    "porch": {
      "name": "Porch",
      "enabled": false,
      "kind": "pid",
      "sensor_id": "temp_1",
      "heat": {
        "relay_id": "relay_1"
      },
      "cool": {
        "relay_id": "relay_9"
      },
      "mode": "heat_cool",
      "setpoint": 20
    },
    "uptime-room": {
      "name": "Uptime Room",
      "enabled": false,
      "kind": "pid",
      "sensor_id": "uptime",
      "heat": {
        "relay_id": "relay_1"
      },
      "mode": "heat",
      "setpoint": 20
    }
  },
  "cases": [
    {
      "name": "A name that is no route is 404",
      "method": "GET",
      "path": "nothing",
      "body": null,
      "status": 404,
      "error": "Unknown endpoint"
    },
    {
      "name": "A GET to a route that writes is 405 naming POST",
      "method": "GET",
      "path": "save",
      "body": null,
      "status": 405,
      "error": "Method not allowed",
      "headers": {
        "Allow": "POST"
      }
    },
    {
      "name": "A POST to a route that reads is 405 naming GET",
      "method": "POST",
      "path": "list",
      "body": null,
      "status": 405,
      "error": "Method not allowed",
      "headers": {
        "Allow": "GET"
      }
    },
    {
      "name": "An OPTIONS is 405 too",
      "method": "OPTIONS",
      "path": "delete?id=living-room",
      "body": null,
      "status": 405,
      "error": "Method not allowed",
      "headers": {
        "Allow": "POST"
      }
    },
    {
      "name": "Ping answers ok",
      "method": "GET",
      "path": "ping",
      "body": null,
      "status": 200,
      "expect": {
        "status": "ok"
      }
    },
    {
      "name": "Schema lists the kinds, the modes, the faults and the limits",
      "method": "GET",
      "path": "schema",
      "body": null,
      "status": 200,
      "expect": {
        "kinds": [
          "pid",
          "bang_bang"
        ],
        "modes": [
          "off",
          "heat",
          "cool",
          "heat_cool"
        ],
        "faults": [
          "none",
          "sensor_stale",
          "overtemp"
        ],
        "max_controllers": 3,
        "name_max_length": 48,
        "params.output.1.key": "min_on_s",
        "params.output.1.def": 10
      }
    },
    {
      "name": "An empty device lists nothing",
      "method": "GET",
      "path": "list",
      "body": null,
      "status": 200,
      "expect": {
        "success": true,
        "count": 0,
        "max_controllers": 3,
        "controllers": []
      }
    },
    {
      "name": "List shows a running thermostat",
      "setup": [
        "living-room"
      ],
      "method": "GET",
      "path": "list",
      "body": null,
      "status": 200,
      "expect": {
        "count": 1,
        "controllers.0.id": "living-room",
        "controllers.0.name": "Living Room",
        "controllers.0.enabled": true,
        "controllers.0.kind": "pid",
        "controllers.0.mode": "heat",
        "controllers.0.sensor_id": "temp_1",
        "controllers.0.heat_relay_id": "relay_1",
        "controllers.0.cool_relay_id": "",
        "controllers.0.running": true,
        "controllers.0.waiting": ""
      }
    },
    {
      "name": "Get answers the bare document with every default filled in",
      "setup": [
        "living-room"
      ],
      "method": "GET",
      "path": "get?id=living-room",
      "body": null,
      "status": 200,
      "expect": {
        "version": 1,
        "id": "living-room",
        "name": "Living Room",
        "enabled": true,
        "setpoint": 22,
        "heat.relay_id": "relay_1",
        "heat.min_on_s": 10,
        "cool.relay_id": "",
        "visual.min_temperature": 5,
        "visual.max_temperature": 45
      },
      "absent": [
        "success"
      ]
    },
    {
      "name": "Get of an unknown id is 404",
      "method": "GET",
      "path": "get?id=ghost",
      "body": null,
      "status": 404,
      "error": "Thermostat not found"
    },
    {
      "name": "Get without an id is 400",
      "method": "GET",
      "path": "get",
      "body": null,
      "status": 400,
      "error": "Missing id parameter"
    },
    {
      "name": "Get of an id that is no slug is 400",
      "method": "GET",
      "path": "get?id=Living-Room",
      "body": null,
      "status": 400,
      "error": "Invalid id parameter"
    },
    {
      "name": "Status of a running thermostat",
      "setup": [
        "living-room"
      ],
      "method": "GET",
      "path": "status?id=living-room",
      "body": null,
      "status": 200,
      "expect": {
        "controllers.0.id": "living-room",
        "controllers.0.running": true,
        "controllers.0.waiting": "",
        "controllers.0.fault": "none",
        "controllers.0.setpoint": 22,
        "controllers.0.min_temperature": 5,
        "controllers.0.max_temperature": 45
      },
      "absent": [
        "controllers.0.switch_low"
      ]
    },
    {
      "name": "Status of a stopped thermostat",
      "setup": [
        "guest-room"
      ],
      "method": "GET",
      "path": "status?id=guest-room",
      "body": null,
      "status": 200,
      "expect": {
        "controllers.0.running": false,
        "controllers.0.waiting": "",
        "controllers.0.action": "off",
        "controllers.0.fault": "none",
        "controllers.0.sensor_age_s": null,
        "controllers.0.heat_duty": 0,
        "controllers.0.heat_relay_on": false,
        "controllers.0.switch_low": 18.5,
        "controllers.0.switch_high": 19.5
      },
      "absent": [
        "controllers.0.pid"
      ]
    },
    {
      "name": "Status of every thermostat comes sorted by id",
      "setup": [
        "living-room",
        "guest-room"
      ],
      "method": "GET",
      "path": "status",
      "body": null,
      "status": 200,
      "expect": {
        "controllers.0.id": "guest-room",
        "controllers.1.id": "living-room"
      }
    },
    {
      "name": "Status of an unknown id is 404",
      "method": "GET",
      "path": "status?id=ghost",
      "body": null,
      "status": 404,
      "error": "Thermostat not found"
    },
    {
      "name": "Status of an empty id is 400",
      "method": "GET",
      "path": "status?id=",
      "body": null,
      "status": 400,
      "error": "Invalid id parameter"
    },
    {
      "name": "Entities offer the sensors in °C and name who holds each relay",
      "setup": [
        "living-room"
      ],
      "method": "GET",
      "path": "entities",
      "body": null,
      "status": 200,
      "expect": {
        "sensors.object_id=temp_1.name": "Temp 1",
        "sensors.object_id=temp_1.unit": "°C",
        "sensors.object_id=temp_2.unit": "°C",
        "switches.object_id=relay_1.name": "Relay 1",
        "switches.object_id=relay_1.claimed_by": "living-room",
        "switches.object_id=relay_2.claimed_by": ""
      },
      "absent": [
        "sensors.object_id=uptime"
      ]
    },
    {
      "name": "Save creates a thermostat and starts it",
      "method": "POST",
      "path": "save",
      "body": {
        "name": "Living Room",
        "kind": "pid",
        "sensor_id": "temp_1",
        "heat": {
          "relay_id": "relay_1"
        },
        "mode": "heat",
        "setpoint": 22
      },
      "status": 200,
      "expect": {
        "success": true,
        "message": "Thermostat created",
        "id": "living-room"
      },
      "absent": [
        "warning"
      ],
      "then": [
        {
          "method": "GET",
          "path": "list",
          "body": null,
          "status": 200,
          "expect": {
            "count": 1,
            "controllers.0.running": true
          }
        }
      ]
    },
    {
      "name": "Save with an id replaces that thermostat, renamed under the same id",
      "setup": [
        "living-room"
      ],
      "method": "POST",
      "path": "save",
      "body": {
        "name": "Lounge",
        "kind": "pid",
        "sensor_id": "temp_1",
        "heat": {
          "relay_id": "relay_1"
        },
        "mode": "heat",
        "setpoint": 19.5,
        "id": "living-room"
      },
      "status": 200,
      "expect": {
        "message": "Thermostat updated",
        "id": "living-room"
      },
      "then": [
        {
          "method": "GET",
          "path": "get?id=living-room",
          "body": null,
          "status": 200,
          "expect": {
            "name": "Lounge",
            "setpoint": 19.5
          }
        }
      ]
    },
    {
      "name": "Save with an empty id creates",
      "setup": [
        "living-room"
      ],
      "method": "POST",
      "path": "save",
      "body": {
        "name": "Floor",
        "kind": "bang_bang",
        "sensor_id": "temp_2",
        "heat": {
          "relay_id": "relay_2"
        },
        "mode": "heat",
        "setpoint": 24,
        "id": ""
      },
      "status": 200,
      "expect": {
        "message": "Thermostat created",
        "id": "floor"
      }
    },
    {
      "name": "Save takes the defaults for what a document leaves out",
      "method": "POST",
      "path": "save",
      "body": {
        "name": "Porch",
        "sensor_id": "temp_1",
        "heat": {
          "relay_id": "relay_1"
        }
      },
      "status": 200,
      "then": [
        {
          "method": "GET",
          "path": "get?id=porch",
          "body": null,
          "status": 200,
          "expect": {
            "kind": "bang_bang",
            "mode": "heat",
            "setpoint": 21,
            "heat.min_off_s": 10
          }
        }
      ]
    },
    {
      "name": "Save with an unknown id is 404",
      "method": "POST",
      "path": "save",
      "body": {
        "name": "Living Room",
        "kind": "pid",
        "sensor_id": "temp_1",
        "heat": {
          "relay_id": "relay_1"
        },
        "mode": "heat",
        "setpoint": 22,
        "id": "ghost"
      },
      "status": 404,
      "error": "Thermostat not found"
    },
    {
      "name": "An empty body is 400",
      "method": "POST",
      "path": "save",
      "body": null,
      "status": 400,
      "error": "Empty request body"
    },
    {
      "name": "A body that is not JSON is 400",
      "method": "POST",
      "path": "save",
      "body": "garbage",
      "status": 400,
      "error": "JSON parse error: InvalidInput"
    },
    {
      "name": "A body cut short is 400",
      "method": "POST",
      "path": "save",
      "body": "{\"name\":\"Broken\",",
      "status": 400,
      "error": "JSON parse error: IncompleteInput"
    },
    {
      "name": "A body that is not an object is 400",
      "method": "POST",
      "path": "save",
      "body": [],
      "status": 400,
      "error": "document is not an object"
    },
    {
      "name": "A document without a name is 400",
      "method": "POST",
      "path": "save",
      "body": {
        "sensor_id": "temp_1",
        "heat": {
          "relay_id": "relay_1"
        }
      },
      "status": 400,
      "error": "name is required"
    },
    {
      "name": "A blank name is 400",
      "method": "POST",
      "path": "save",
      "body": {
        "name": "   ",
        "kind": "pid",
        "sensor_id": "temp_1",
        "heat": {
          "relay_id": "relay_1"
        },
        "mode": "heat",
        "setpoint": 22
      },
      "status": 400,
      "error": "Name is required"
    },
    {
      "name": "A name with a slash is 400",
      "method": "POST",
      "path": "save",
      "body": {
        "name": "Up/down",
        "kind": "pid",
        "sensor_id": "temp_1",
        "heat": {
          "relay_id": "relay_1"
        },
        "mode": "heat",
        "setpoint": 22
      },
      "status": 400,
      "error": "Name cannot contain '/'"
    },
    {
      "name": "A name longer than 48 characters is 400",
      "method": "POST",
      "path": "save",
      "body": {
        "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "kind": "pid",
        "sensor_id": "temp_1",
        "heat": {
          "relay_id": "relay_1"
        },
        "mode": "heat",
        "setpoint": 22
      },
      "status": 400,
      "error": "Name is longer than 48 characters"
    },
    {
      "name": "The file format's rules come before the name's",
      "method": "POST",
      "path": "save",
      "body": {
        "name": "Up/down",
        "heat": {
          "relay_id": "relay_1"
        }
      },
      "status": 400,
      "error": "sensor_id is required"
    },
    {
      "name": "A document without a relay is 400",
      "method": "POST",
      "path": "save",
      "body": {
        "name": "A",
        "sensor_id": "temp_1"
      },
      "status": 400,
      "error": "at least one of heat.relay_id / cool.relay_id is required"
    },
    {
      "name": "One relay for both directions is 400",
      "method": "POST",
      "path": "save",
      "body": {
        "name": "Living Room",
        "kind": "pid",
        "sensor_id": "temp_1",
        "heat": {
          "relay_id": "relay_1"
        },
        "mode": "heat_cool",
        "setpoint": 22,
        "cool": {
          "relay_id": "relay_1"
        }
      },
      "status": 400,
      "error": "heat and cool cannot share one relay"
    },
    {
      "name": "An unknown kind is 400",
      "method": "POST",
      "path": "save",
      "body": {
        "name": "Living Room",
        "kind": "fuzzy",
        "sensor_id": "temp_1",
        "heat": {
          "relay_id": "relay_1"
        },
        "mode": "heat",
        "setpoint": 22
      },
      "status": 400,
      "error": "kind must be 'pid' or 'bang_bang'"
    },
    {
      "name": "An unknown mode is 400",
      "method": "POST",
      "path": "save",
      "body": {
        "name": "Living Room",
        "kind": "pid",
        "sensor_id": "temp_1",
        "heat": {
          "relay_id": "relay_1"
        },
        "mode": "dry",
        "setpoint": 22
      },
      "status": 400,
      "error": "mode must be one of off/heat/cool/heat_cool"
    },
    {
      "name": "A mode its relays cannot serve is 400",
      "method": "POST",
      "path": "save",
      "body": {
        "name": "Living Room",
        "kind": "pid",
        "sensor_id": "temp_1",
        "heat": {
          "relay_id": "relay_1"
        },
        "mode": "cool",
        "setpoint": 22
      },
      "status": 400,
      "error": "mode 'cool' needs cool.relay_id"
    },
    {
      "name": "A range that ends below where it starts is 400",
      "method": "POST",
      "path": "save",
      "body": {
        "name": "Living Room",
        "kind": "pid",
        "sensor_id": "temp_1",
        "heat": {
          "relay_id": "relay_1"
        },
        "mode": "heat",
        "setpoint": 22,
        "visual": {
          "min_temperature": 30,
          "max_temperature": 20
        }
      },
      "status": 400,
      "error": "visual.max_temperature must be above visual.min_temperature"
    },
    {
      "name": "A body over 8 KiB is 413",
      "method": "POST",
      "path": "save",
      "body": {
        "name": "Living Room",
        "kind": "pid",
        "sensor_id": "temp_1",
        "heat": {
          "relay_id": "relay_1"
        },
        "mode": "heat",
        "setpoint": 22
      },
      "pad_to": 8193,
      "status": 413,
      "error": "Request body over 8 KiB",
      "then": [
        {
          "method": "GET",
          "path": "list",
          "body": null,
          "status": 200,
          "expect": {
            "count": 0
          }
        }
      ]
    },
    {
      "name": "A body of 8 KiB is read",
      "method": "POST",
      "path": "save",
      "body": {
        "name": "Living Room",
        "kind": "pid",
        "sensor_id": "temp_1",
        "heat": {
          "relay_id": "relay_1"
        },
        "mode": "heat",
        "setpoint": 22
      },
      "pad_to": 8192,
      "status": 200,
      "expect": {
        "id": "living-room"
      }
    },
    {
      "name": "A name another thermostat answers to is 409",
      "setup": [
        "living-room"
      ],
      "method": "POST",
      "path": "save",
      "body": {
        "name": "living  ROOM",
        "kind": "bang_bang",
        "sensor_id": "temp_2",
        "heat": {
          "relay_id": "relay_2"
        },
        "mode": "heat",
        "setpoint": 24
      },
      "status": 409,
      "error": "\"living  ROOM\" is already used by another thermostat"
    },
    {
      "name": "A name Home Assistant would take for another is 409",
      "setup": [
        "living-room"
      ],
      "method": "POST",
      "path": "save",
      "body": {
        "name": "Living_Room",
        "kind": "bang_bang",
        "sensor_id": "temp_2",
        "heat": {
          "relay_id": "relay_2"
        },
        "mode": "heat",
        "setpoint": 24
      },
      "status": 409,
      "error": "\"Living_Room\" is too close to \"Living Room\": both are living_room to Home Assistant"
    },
    {
      "name": "A climate's name from the YAML is 409",
      "method": "POST",
      "path": "save",
      "body": {
        "name": "Hall",
        "kind": "bang_bang",
        "sensor_id": "temp_2",
        "heat": {
          "relay_id": "relay_2"
        },
        "mode": "heat",
        "setpoint": 24
      },
      "status": 409,
      "error": "\"Hall\" is already used by another thermostat"
    },
    {
      "name": "Its own name never blocks a thermostat",
      "setup": [
        "living-room"
      ],
      "method": "POST",
      "path": "save",
      "body": {
        "name": "Living Room",
        "kind": "pid",
        "sensor_id": "temp_1",
        "heat": {
          "relay_id": "relay_1"
        },
        "mode": "heat",
        "setpoint": 22,
        "id": "living-room"
      },
      "status": 200,
      "expect": {
        "message": "Thermostat updated"
      }
    },
    {
      "name": "A create past max_controllers is 507",
      "setup": [
        "living-room",
        "floor",
        "guest-room"
      ],
      "method": "POST",
      "path": "save",
      "body": {
        "name": "Den",
        "kind": "bang_bang",
        "sensor_id": "temp_2",
        "heat": {
          "relay_id": "relay_2"
        },
        "mode": "heat",
        "setpoint": 24,
        "enabled": false
      },
      "status": 507,
      "error": "This device allows 3 thermostats; delete one to add another"
    },
    {
      "name": "The limit comes before the name",
      "setup": [
        "living-room",
        "floor",
        "guest-room"
      ],
      "method": "POST",
      "path": "save",
      "body": {
        "name": "Living Room",
        "kind": "pid",
        "sensor_id": "temp_1",
        "heat": {
          "relay_id": "relay_1"
        },
        "mode": "heat",
        "setpoint": 22,
        "enabled": false
      },
      "status": 507,
      "error": "This device allows 3 thermostats; delete one to add another"
    },
    {
      "name": "A taken name comes first, then a sensor not in °C, then a held relay",
      "setup": [
        "living-room"
      ],
      "method": "POST",
      "path": "save",
      "body": {
        "name": "living room",
        "kind": "pid",
        "sensor_id": "uptime",
